{
  "name": "BruceClaw",
  "version": "1.0",
  "lazarus_path": "/data/data/com.termux/files/home/Lazarus",
  "memory": {
    "path": "memory",
    "max_entries": 1000,
    "auto_save": true
  },
  "tools": {
    "path": "tools",
    "enabled": ["files", "shell", "sms", "contacts", "calendar", "camera", "web"],
    "require_permission": ["sms", "contacts", "calendar", "shell"]
  },
  "mcp": {
    "path": "mcp",
    "servers": []
  },
  "skills": {
    "path": "skills"
  },
  "logs": {
    "path": "logs",
    "max_size_mb": 10
  },
  "security": {
    "prompt_injection_protection": true,
    "validate_input": true,
    "log_suspicious": true,
    "blocked_commands": ["rm -rf", "sudo", "chmod 777", "eval"]
  }
}
